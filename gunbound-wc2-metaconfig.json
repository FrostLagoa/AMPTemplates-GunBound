        "game.golf.factor":"CfgWc2GolfFactor",
        "game.score.factor":"CfgWc2ScoreFactor",
        "game.grade.first":"CfgWc2GradeFirst",
        "game.grade.last":"CfgWc2GradeLast",
        "game.function.restriction":"CfgWc2FunctionRestriction",
