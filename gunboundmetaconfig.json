[
  {
    "ConfigFile": "runtime-config/config/db.properties",
    "ConfigType": "kvp",
    "ConfigFormat": "{0}={1}",
    "ConfigFormatRegex": "^\\s*(?<key>[^#!\\s][^=]*?)\\s*=\\s*(?<value>.*?)\\s*$",
    "Subsections": [
      {
        "Heading": "$root",
        "SettingMappings": {
          "server.public.ip": "CfgGunboundDotNetServerPublicIp",
          "server.lan.ip": "CfgGunboundDotNetServerLanIp",
          "server.bind.ip": "CfgGunboundDotNetServerBindIp",
          "broker.port": "CfgGunboundDotNetBrokerPort",
          "broker.name": "CfgGunboundDotNetBrokerName",
          "broker.description": "CfgGunboundDotNetBrokerDescription",
          "broker.capacity": "CfgGunboundDotNetBrokerCapacity",
          "game.port": "CfgGunboundDotNetGamePort",
          "buddy.port": "CfgGunboundDotNetBuddyPort",
          "buddy.udp.port": "CfgGunboundDotNetBuddyUdpPort",
          "p2p.enabled": "CfgGunboundDotNetP2pEnabled",
          "debug.packets": "CfgGunboundDotNetDebugPackets",
          "max.sessions.per.ip": "CfgGunboundDotNetMaxSessionsPerIp",
          "spawn.force.aside": "CfgGunboundDotNetSpawnForceAside",
          "shop.block.ex.items": "CfgGunboundDotNetShopBlockExItems",
          "tunnel.dedup.window.ms": "CfgGunboundDotNetTunnelDedupWindowMs",
          "anticheat.max.gold.per.match": "CfgGunboundDotNetAnticheatMaxGoldPerMatch",
          "anticheat.max.gp.per.match": "CfgGunboundDotNetAnticheatMaxGpPerMatch",
          "gameserver.eventactprop": "CfgGunboundDotNetGameserverEventactprop",
          "gameserver.eventscore.enabled": "CfgGunboundDotNetGameserverEventscoreEnabled"
        }
      }
    ]
  }
]
