diff --git a/Net/GameConnection.cs b/Net/GameConnection.cs
index bc135f3..518938f 100644
--- a/Net/GameConnection.cs
+++ b/Net/GameConnection.cs
@@ -61,3 +61,16 @@ public sealed class GameConnection
             {
-                try { Socket.Send(bytes); }
+                try
+                {
+                    // Socket.Send is allowed to write fewer bytes than requested.
+                    // A partial GunBound frame desynchronizes every packet that
+                    // follows it and commonly leaves the client in PLEASE WAIT.
+                    int sent = 0;
+                    while (sent < bytes.Length)
+                    {
+                        int written = Socket.Send(bytes, sent, bytes.Length - sent, SocketFlags.None);
+                        if (written <= 0)
+                            throw new SocketException((int)SocketError.ConnectionReset);
+                        sent += written;
+                    }
+                }
                 catch { break; } // dead connection: stop the loop
@@ -102,2 +115,5 @@ public sealed class GameConnection
             _sendQueue.Writer.TryWrite(bytes);
+
+            if (command is 0x2121 or 0x3105 or 0x3432)
+                Console.WriteLine($"SEND> 0x{command:X4} payload={data.ReadableBytes}B packet={bytes.Length}B txsum={TxSum}");
         }
