App.DisplayName=Gunbound
App.RootDir=./gunbound-amp/
App.BaseDirectory=./
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
App.ExecutableLinux=
App.WorkingDir=.
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "{{$FullRootDir}}gunbound-supervisor.ps1" -ServerRoot "{{ServerRoot}}" -PythonExecutable "{{PythonExecutable}}" -CredentialStorePath "{{CredentialStorePath}}" -DatabaseHost "{{DatabaseHost}}" -DatabasePort {{DatabasePort}} -DatabaseName "{{DatabaseName}}" -BrokerPort {{$ApplicationPort1}} -GamePort {{$ApplicationPort2}} -ShutdownTimeoutSeconds {{ShutdownTimeoutSeconds}}
App.UseLinuxIOREDIR=False
App.AppSettings={"ServerRoot":"D:\\Gunbound","PythonExecutable":"D:\\Python\\Python310\\python.exe","CredentialStorePath":"D:\\Gunbound\\config\\iris-sql-vault.local.json","DatabaseHost":"127.0.0.1","DatabasePort":"3303","DatabaseName":"gunbound","DatabaseReadyGraceSeconds":"5","ShutdownTimeoutSeconds":"30"}
App.EnvironmentVariables={}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter=
App.ExitMethod=String
App.ExitMethodWindows=CtrlC
App.ExitTimeout=45
App.ExitString=ampstop
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=[{"Protocol":0,"Port":8400,"Offset":0,"Range":1,"MinListening":0,"Ref":"ApplicationPort1","Name":"External Broker service","Description":"External WC2 server-directory and world-selection service","IsDelayedOpen":false,"Hidden":false,"ChildPorts":null,"Required":false},{"Protocol":0,"Port":8401,"Offset":0,"Range":1,"MinListening":0,"Ref":"ApplicationPort2","Name":"Game service","Description":"Shared WC2 game protocol service","IsDelayedOpen":false,"Hidden":false,"ChildPorts":null,"Required":false},{"Protocol":0,"Port":8402,"Offset":0,"Range":1,"MinListening":0,"Ref":"ApplicationPort3","Name":"LAN Broker service","Description":"Private-LAN WC2 server-directory and world-selection service","IsDelayedOpen":false,"Hidden":false,"ChildPorts":null,"Required":false}]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ApplicationPort1
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=500
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=status
App.TelnetLoginFormat={0}
App.UpdateSources=[{"UpdateStageName":"Install GunBound supervisor","UpdateSourcePlatform":"Windows","UpdateSource":"FetchURL","UpdateSourceData":"https://raw.githubusercontent.com/FrostLagoa/AMPTemplates-GunBound/main/gunbound-supervisor.ps1","UpdateSourceArgs":"gunbound-supervisor.ps1","UpdateSourceTarget":"{{$FullRootDir}}","OverwriteExistingFiles":true,"SkipOnFailure":false},{"UpdateStageName":"Install WC2 scoped-Vault launcher","UpdateSourcePlatform":"Windows","UpdateSource":"FetchURL","UpdateSourceData":"https://raw.githubusercontent.com/FrostLagoa/AMPTemplates-GunBound/main/legacy-gunbound-launcher.py","UpdateSourceArgs":"legacy-gunbound-launcher.py","UpdateSourceTarget":"{{$FullRootDir}}","OverwriteExistingFiles":true,"SkipOnFailure":false},{"UpdateStageName":"Install persisted configuration link helper","UpdateSourcePlatform":"Windows","UpdateSource":"FetchURL","UpdateSourceData":"https://raw.githubusercontent.com/FrostLagoa/AMPTemplates-GunBound/main/amp-config-link.ps1","UpdateSourceArgs":"amp-config-link.ps1","UpdateSourceTarget":"{{$FullRootDir}}","OverwriteExistingFiles":true,"SkipOnFailure":false}]
