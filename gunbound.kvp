Meta.DisplayName=Gunbound
Meta.Description=Supervised GunBound Java server using a scoped DPAPI projection of the Iris SQL identity.
Meta.OS=Windows
Meta.AarchSupport=Native
Meta.Arch=x86_64
Meta.Author=FrostLagoa
Meta.URL=https://github.com/kyll3r/GunBound-Java-Server
Meta.DisplayImageSource=url:https://raw.githubusercontent.com/FrostLagoa/AMPTemplates-GunBound/94eab7155d7065ae258997c62224f1ef58ec7b0d/gunbound-banner.jpg
Meta.EndpointURIFormat=
Meta.ConfigManifest=gunboundconfig.json
Meta.MetaConfigManifest=gunboundmetaconfig.json
Meta.ConfigRoot=gunbound.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=https://github.com/FrostLagoa/AMPTemplates-GunBound
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=6
Meta.ReleaseNotes=Add configurable player slots and LAN-aware endpoint advertisement alongside the complete managed server settings.
Meta.BreakingReleaseNotes=
Meta.AppConfigId=4ee8a32f-4c8d-498a-82b8-40c179addf11
Meta.ImportableExtensions=[]
App.DisplayName=Gunbound
App.RootDir=./gunbound-amp/
App.BaseDirectory=./
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
App.ExecutableLinux=
App.WorkingDir=.
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "{{$FullRootDir}}gunbound-supervisor.ps1" -ServerRoot "{{ServerRoot}}" -PythonExecutable "{{PythonExecutable}}" -JavaExecutable "{{JavaExecutable}}" -CredentialStorePath "{{CredentialStorePath}}" -DatabaseHost "{{DatabaseHost}}" -DatabasePort {{DatabasePort}} -DatabaseName "{{DatabaseName}}" -BrokerPort {{$ApplicationPort1}} -GamePort {{$ApplicationPort2}} -BuddyPort {{$ApplicationPort3}} -BuddyUdpPort {{$ApplicationPort4}} -AutoRestart {{AutoRestart}} -RestartLimit {{RestartLimit}} -RestartBackoffSeconds {{RestartBackoffSeconds}} -ShutdownTimeoutSeconds {{ShutdownTimeoutSeconds}}
App.UseLinuxIOREDIR=False
App.AppSettings={"ServerRoot":"D:\\Gunbound\\Server","PythonExecutable":"D:\\Python\\Python310\\python.exe","JavaExecutable":"C:\\Program Files\\Common Files\\Oracle\\Java\\javapath\\java.exe","CredentialStorePath":"D:\\Gunbound\\Server\\config\\iris-sql-vault.local.json","DatabaseHost":"127.0.0.1","DatabasePort":"3306","DatabaseName":"gunbound","AutoRestart":"true","RestartLimit":"3","RestartBackoffSeconds":"3","ShutdownTimeoutSeconds":"30"}
App.EnvironmentVariables={}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter=
App.ExitMethod=String
App.ExitTimeout=45
App.ExitString=ampstop
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[gunboundports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ApplicationPort1
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=500
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=status
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[gunboundupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.sql","*.ps1","*.py"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=True
App.MonitorChildProcessName=java.exe
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^\[supervisor\] READY broker=\d+ game=\d+ buddy=\d+ buddy_udp=\d+$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^(?:\[stdout\]\s+)?\[(?:CHAT|BCM)\]\s+(?<player>[^:]{1,32}):\s+(?<message>.+)$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=0
Limits.SleepStartThresholdSeconds=25
