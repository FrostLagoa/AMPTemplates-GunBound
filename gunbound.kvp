Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=9
Meta.ReleaseNotes=Run the native GunBound WC2 runtime in the Kallidos session while AMP provides explicit start, stop and restart control plus read-only runtime logs.
